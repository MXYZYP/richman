{
  "name": "@richman/weapp",
  "version": "0.1.0",
  "private": true,
  "description": "大富翁·中国之旅 微信小程序端（uni-app / Vue3 / mp-weixin）",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-sources.mjs",
    "build:mp": "node scripts/sync-sources.mjs && node scripts/scan-tags.mjs && uni build -p mp-weixin",
    "dev:mp": "node scripts/sync-sources.mjs && uni -p mp-weixin",
    "build:h5": "node scripts/sync-sources.mjs && uni build",
    "dev:h5": "uni",
    "verify": "node scripts/verify-turn.cjs",
    "scan:tags": "node scripts/scan-tags.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030220261016001",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5030220261016001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030220261016001",
    "@vue/runtime-core": "3.4.21",
    "typescript": "^5.4.5",
    "vite": "5.2.8",
    "vue-tsc": "^2.0.0"
  }
}
