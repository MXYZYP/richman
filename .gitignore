# 依赖
node_modules/

# 构建产物
dist/
build/
*.tsbuildinfo

# 编辑器/系统
.DS_Store
.vscode/
.idea/

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 本地环境
.env
.env.local

# deepwork 进度文件（OpenCode 可读，不入 git）
.slim/deepwork/

# 本地 worktree 隔离工作区
.worktrees/

# 工具本地元数据
.omp/
.superpowers/

# AI 协作工具的项目级数据（含工作日志与长期笔记），不入 git
.workbuddy/

# 系统噪声
Thumbs.db

# 运行期存档（如后续实现持久化，不应入库）
saves/

# 服务端房间快照（C-③）：运行期数据，含玩家 token，绝不入库
.runtime/

# 端到端测试（Playwright）运行期产物：trace / 截图 / 报告，绝不入库
e2e/.artifacts/
playwright-report/
test-results/

# 密钥/证书，绝不入库
*.pem
*.key

# 鸿蒙工程（apps/harmonyos）：DevEco 本地产物与签名材料，绝不入库
oh_modules/
.hvigor/
.cxx/
local.properties
*.har
*.p12
*.cer
*.p7b
*.csr
